# ─────────────────────────────────────────────────────────────
# Smart MIS — environment variables (all optional)
# Copy to `.env` in the project root. Never commit your real .env.
# The app works fully without any of these: uploads, dashboards,
# KPIs, insights and reports all run in the browser.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# URL(s) people open the app from (comma-separated). Dev: the Vite server.
APP_ORIGIN=http://localhost:5173

# ── Optional AI insights (Groq free tier: https://console.groq.com/keys) ──
# Only computed summary statistics are sent — never raw rows — and only
# after the user ticks the consent box on the AI Insights page.
GROQ_API_KEY=
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
AI_ENABLED=true
# Per-IP hourly limit to protect your free quota
AI_REQUESTS_PER_HOUR=30
