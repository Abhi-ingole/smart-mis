# ─────────────────────────────────────────────────────────────
# Smart MIS — environment variables
# Copy this file to `.env` (in the project root) and fill in real values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
PORT=4000

# Public URL the browser uses. Only this origin is allowed by CORS.
# Dev: the Vite dev server. Production: https://mis.yourdomain.com
APP_ORIGIN=http://localhost:5173

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without a strong secret.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# SQLite database file (relative to the /server folder)
DATABASE_URL=file:./data/smart-mis.db

# Folders for uploaded files and nightly backups (relative to /server)
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ── AI: Groq free tier (https://console.groq.com/keys) ──
# Leave GROQ_API_KEY empty to run without AI (rule-based extraction + template summaries).
GROQ_API_KEY=
# Comma-separated lists. The first model is tried first; the rest are fallbacks.
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
GROQ_VISION_MODELS=qwen/qwen3.8-27b,meta-llama/llama-4-scout-17b-16e-instruct

# ── Email: Gmail SMTP with an App Password ──
# https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name for the From header
MAIL_FROM_NAME=Smart MIS
# true = don't actually send; log the email to the console instead (useful in dev)
EMAIL_DRY_RUN=false

# ── Optional: WhatsApp Cloud API (Meta). Disabled unless BOTH are set ──
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v21.0

# Cookies are HTTPS-only in production. Set false ONLY for a quick test over plain http.
# COOKIE_SECURE=true

# Turn the background scheduler (auto-send, backups) on/off
ENABLE_CRON=true
